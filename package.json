{
  "name": "devspace-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "deploy": "pnpm build && wrangler deploy",
    "preview": "pnpm build && wrangler dev",
    "resume:source": "node scripts/build-resume.mjs",
    "resume:pdf": "pnpm resume:source && typst compile resume/thomas-miller-master.typ output/pdf/thomas-miller-master-resume.pdf --pdf-standard ua-1 && node scripts/publish-resume.mjs",
    "start": "next start",
    "lint": "eslint . --fix",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@types/mdx": "^2.0.13",
    "date-fns": "^4.1.0",
    "next": "16.2.10",
